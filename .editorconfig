# ktlint reads this file (through Spotless). Kotlin official style, ktlint_official rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = ktlint_official
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# No wildcard imports (CLAUDE.md conventions).
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset
# Composables are named like types (TypewrightApp), as Compose requires.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.gradle.kts]
# Version-catalog accessors (libs.versions.x.get()) read best on one line in build scripts.
ktlint_standard_chain-method-continuation = disabled

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
