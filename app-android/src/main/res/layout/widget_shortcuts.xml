<!-- W6 Shortcuts (docs/SCREENS_V1.md §9.2): three square ink-block pads; small shows the first.
     No top or bottom padding, so a one-row widget keeps its 48 dp pads; 2 dp label insets, so
     WORKBOOK fits a pad from a 270 dp wide widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/TypewrightWidget.Root"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/widget_pad_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_pad_0_label"
            style="@style/TypewrightWidget.Text.Block"
            android:layout_width="match_parent"
            android:gravity="center"
            android:minHeight="@dimen/widget_touch_target"
            android:paddingStart="@dimen/widget_pad_inset"
            android:paddingEnd="@dimen/widget_pad_inset"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/widget_pad_0_sub"
            style="@style/TypewrightWidget.Text.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pad_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_pad_1_label"
            style="@style/TypewrightWidget.Text.Block"
            android:layout_width="match_parent"
            android:gravity="center"
            android:minHeight="@dimen/widget_touch_target"
            android:paddingStart="@dimen/widget_pad_inset"
            android:paddingEnd="@dimen/widget_pad_inset"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/widget_pad_1_sub"
            style="@style/TypewrightWidget.Text.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pad_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_pad_2_label"
            style="@style/TypewrightWidget.Text.Block"
            android:layout_width="match_parent"
            android:gravity="center"
            android:minHeight="@dimen/widget_touch_target"
            android:paddingStart="@dimen/widget_pad_inset"
            android:paddingEnd="@dimen/widget_pad_inset"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/widget_pad_2_sub"
            style="@style/TypewrightWidget.Text.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
