<!-- W1 Approved picker preview (docs/SCREENS_V1.md §9.3): the mockups' sample, never on a home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/TypewrightWidget.Root"
    android:orientation="vertical">

    <TextView
        style="@style/TypewrightWidget.Text.Title"
        android:text="@string/widget_your_font" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/TypewrightWidget.Text.Number"
            android:text="@string/widget_preview_approved_value" />

        <TextView
            style="@style/TypewrightWidget.Text.Label"
            android:layout_marginStart="8dp"
            android:text="@string/widget_approved_label" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_bar"
        android:layout_marginTop="@dimen/widget_gap"
        android:max="338"
        android:progress="52"
        android:progressDrawable="@drawable/widget_bar" />

    <TextView
        style="@style/TypewrightWidget.Text.Label"
        android:layout_marginTop="@dimen/widget_gap"
        android:text="@string/widget_preview_as_of" />
</LinearLayout>
