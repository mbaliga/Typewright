<!-- W1's square bar: fg for approved over the line colour (SCREENS_V1 §9.2). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_fg" />
            </shape>
        </clip>
    </item>
</layer-list>
